<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Gestión de Clientes</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

    <!-- BARRA DE NAVEGACIÓN -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">

            <a class="navbar-brand" href="#">
                Sistema MVC
            </a>

            <div class="navbar-nav">

                <a class="nav-link"
                   th:href="@{/clientes}">
                    Clientes
                </a>

                <a class="nav-link"
                   th:href="@{/empleados}">
                    Empleados
                </a>

                <a class="nav-link"
                   th:href="@{/productos}">
                    Productos
                </a>

            </div>
        </div>
    </nav>


    <div class="container mt-4">

        <h2 class="mb-4">
            Gestión de Clientes
        </h2>


        <!-- MENSAJES -->
        <div th:if="${mensaje}"
             class="alert alert-success"
             th:text="${mensaje}">
        </div>

        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>


        <!-- FORMULARIO -->
        <div class="card shadow mb-4">

            <div class="card-header bg-primary text-white">
                Registro de Cliente
            </div>

            <div class="card-body">

                <form th:action="@{/clientes/guardar}"
                      th:object="${cliente}"
                      method="post">

                    <input type="hidden"
                           th:field="*{id}">


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                NIT
                            </label>

                            <input type="text"
                                   class="form-control"
                                   th:field="*{nit}"
                                   placeholder="Ingrese el NIT"
                                   required>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   th:field="*{nombre}"
                                   placeholder="Ingrese el nombre"
                                   required>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Apellidos
                            </label>

                            <input type="text"
                                   class="form-control"
                                   th:field="*{apellidos}"
                                   placeholder="Ingrese los apellidos"
                                   required>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   class="form-control"
                                   th:field="*{email}"
                                   placeholder="Ingrese el correo"
                                   required>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-success">

                        Guardar Cliente

                    </button>

                </form>

            </div>
        </div>


        <!-- TABLA -->
        <div class="card shadow">

            <div class="card-header bg-dark text-white">
                Lista de Clientes
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>NIT</th>
                                <th>Nombre</th>
                                <th>Apellidos</th>
                                <th>Email</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>


                        <tbody>

                            <tr th:each="c : ${clientes}">

                                <td th:text="${c.id}"></td>

                                <td th:text="${c.nit}"></td>

                                <td th:text="${c.nombre}"></td>

                                <td th:text="${c.apellidos}"></td>

                                <td th:text="${c.email}"></td>

                                <td>

                                    <a th:href="@{/clientes/editar/{id}(id=${c.id})}"
                                       class="btn btn-warning btn-sm">

                                        Editar

                                    </a>


                                    <form th:action="@{/clientes/eliminar/{id}(id=${c.id})}"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">

                                            Eliminar

                                        </button>

                                    </form>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <div th:if="${#lists.isEmpty(clientes)}"
                     class="alert alert-info">

                    No hay clientes registrados.

                </div>

            </div>
        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
