# Crud-MVC-web
Crud MVC web
<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Empleados</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

    <!-- BARRA DE NAVEGACION -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand" th:href="@{/empleados}">
                Sistema MVC
            </a>

            <div class="navbar-nav">

                <a class="nav-link"
                   th:href="@{/clientes}">
                    Clientes
                </a>

                <a class="nav-link active"
                   th:href="@{/empleados}">
                    Empleados
                </a>

                <a class="nav-link"
                   th:href="@{/productos}">
                    Productos
                </a>

            </div>

        </div>

    </nav>


    <!-- CONTENIDO -->
    <div class="container mt-4">

        <h2 class="text-center mb-4">
            Gestión de Empleados
        </h2>


        <!-- MENSAJE DE EXITO -->
        <div th:if="${mensaje}"
             class="alert alert-success"
             th:text="${mensaje}">
        </div>


        <!-- MENSAJE DE ERROR -->
        <div th:if="${error}"
             class="alert alert-danger"
             th:text="${error}">
        </div>


        <!-- FORMULARIO -->
        <div class="card mb-4">

            <div class="card-header bg-primary text-white">
                Registro de Empleado
            </div>

            <div class="card-body">

                <form th:action="@{/empleados/guardar}"
                      th:object="${empleado}"
                      method="post">


                    <!-- ID EMPLEADO -->
                    <input type="hidden"
                           th:field="*{idEmpleado}">


                    <div class="row">


                        <!-- ID PUESTO -->
                        <div class="col-md-3 mb-3">

                            <label class="form-label">
                                ID Puesto
                            </label>

                            <input type="number"
                                   class="form-control"
                                   th:field="*{idPuesto}"
                                   required>

                        </div>


                        <!-- NOMBRE -->
                        <div class="col-md-3 mb-3">

                            <label class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   th:field="*{nombre}"
                                   required>

                        </div>


                        <!-- APELLIDOS -->
                        <div class="col-md-3 mb-3">

                            <label class="form-label">
                                Apellidos
                            </label>

                            <input type="text"
                                   class="form-control"
                                   th:field="*{apellidos}"
                                   required>

                        </div>


                        <!-- FECHA DE CONTRATACION -->
                        <div class="col-md-3 mb-3">

                            <label class="form-label">
                                Fecha de Contratación
                            </label>

                            <input type="date"
                                   class="form-control"
                                   th:field="*{fechaContratacion}"
                                   required>

                        </div>

                    </div>


                    <!-- BOTONES -->
                    <button type="submit"
                            class="btn btn-success">
                        Guardar Empleado
                    </button>

                    <a th:href="@{/empleados}"
                       class="btn btn-secondary">
                        Limpiar
                    </a>

                </form>

            </div>

        </div>


        <!-- TABLA -->
        <div class="card">

            <div class="card-header bg-dark text-white">
                Empleados Registrados
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped table-hover">

                        <thead class="table-dark">

                            <tr>

                                <th>ID Empleado</th>

                                <th>ID Puesto</th>

                                <th>Nombre</th>

                                <th>Apellidos</th>

                                <th>Fecha de Contratación</th>

                                <th>Acciones</th>

                            </tr>

                        </thead>


                        <tbody>


                            <!-- LISTA DE EMPLEADOS -->
                            <tr th:each="e : ${empleados}">

                                <td th:text="${e.idEmpleado}">
                                </td>

                                <td th:text="${e.idPuesto}">
                                </td>

                                <td th:text="${e.nombre}">
                                </td>

                                <td th:text="${e.apellidos}">
                                </td>

                                <td th:text="${e.fechaContratacion}">
                                </td>


                                <!-- ACCIONES -->
                                <td>

                                    <!-- EDITAR -->
                                    <a class="btn btn-primary btn-sm"
                                       th:href="@{/empleados/editar/{idEmpleado}(idEmpleado=${e.idEmpleado})}">
                                        Editar
                                    </a>


                                    <!-- ELIMINAR -->
                                    <form class="d-inline"
                                          th:action="@{/empleados/eliminar/{idEmpleado}(idEmpleado=${e.idEmpleado})}"
                                          method="post">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('¿Está seguro de eliminar este empleado?')">

                                            Eliminar

                                        </button>

                                    </form>

                                </td>

                            </tr>


                            <!-- SI NO EXISTEN EMPLEADOS -->
                            <tr th:if="${empleados == null or #lists.isEmpty(empleados)}">

                                <td colspan="6"
                                    class="text-center">

                                    No hay empleados registrados.

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>


    <!-- BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>
